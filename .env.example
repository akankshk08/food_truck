# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public address of the website (used for SEO and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Database. Leave as-is for local development (a file in ./data).
# In production use Turso: DATABASE_URL=libsql://<your-db>.turso.io and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Photo storage. Required on Vercel (its disk is read-only): create a Blob store in the
# Vercel dashboard and connect it to the project — it sets BLOB_STORE_ID (or, on older
# setups, BLOB_READ_WRITE_TOKEN) automatically. Leave both empty to save photos in UPLOAD_DIR.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=./data/uploads
